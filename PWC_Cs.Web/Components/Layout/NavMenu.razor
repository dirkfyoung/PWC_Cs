@rendermode InteractiveServer
@using System.IO
@using PWC_Cs.Web.Services

@inject ProjectState ProjectState
@inject ProjectFileService FileService
@inject PrzmVvwmInputWriter PrzmWriter

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">PWC_Cs.Web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/chemical-inputs">
                Chemical Inputs
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/scheme-inputs">
                Scheme Inputs
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/waterbody">
                Waterbody
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/output-options">
                Output Options
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/advanced-settings">
                Advanced Settings
            </NavLink>
        </div>

        <hr class="text-white" />

        <div class="px-3">
            <label class="form-label text-white">JSON File Path</label>
            <InputText class="form-control mb-2" @bind-Value="_jsonFilePath" />

            <button class="btn btn-primary w-100 mb-2" type="button" @onclick="SaveProject">
                Save Project
            </button>

            <button class="btn btn-secondary w-100 mb-3" type="button" @onclick="LoadProject">
                Load Project
            </button>

            <label class="form-label text-white">PRZM Input File Path</label>
            <InputText class="form-control mb-2" @bind-Value="_przmFilePath" />

            <button class="btn btn-success w-100" type="button" @onclick="WritePrzmInput">
                Write PRZM Input
            </button>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="alert alert-info mt-2">@_message</div>
            }
        </div>
    </nav>
</div>

@code {
    private string _jsonFilePath = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.Desktop),
        "PWC_project",
        "PWC_Project.json");

    private string _przmFilePath = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.Desktop),
        "PWC_project",
        "przm_input_test.txt");

    private string? _message;

    private async Task SaveProject()
    {
        try
        {
            await FileService.SaveAsync(ProjectState.Current, _jsonFilePath);
            _message = $"Project saved to {_jsonFilePath}";
        }
        catch (Exception ex)
        {
            _message = $"Save failed: {ex.Message}";
        }
    }

    private async Task LoadProject()
    {
        try
        {
            ProjectState.Load(await FileService.LoadAsync(_jsonFilePath));
            _message = $"Project loaded from {_jsonFilePath}";
        }
        catch (Exception ex)
        {
            _message = $"Load failed: {ex.Message}";
        }
    }

    private async Task WritePrzmInput()
    {
        try
        {
            await PrzmWriter.WriteAsync(ProjectState.Current, _przmFilePath);
            _message = $"PRZM input written to {_przmFilePath}";
        }
        catch (Exception ex)
        {
            _message = $"PRZM write failed: {ex.Message}";
        }
    }
}