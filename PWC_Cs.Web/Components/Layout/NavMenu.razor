@using System.IO
@using PWC_Cs.Web.Services

@rendermode InteractiveServer
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">PWC_Cs.Web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/chemical-inputs">
                Chemical Inputs
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/waterbody">
                Waterbody
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/scheme-inputs">
                Scheme Inputs
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/advanced-settings">
                Advanced Settings
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/output-options">
                Output Options
            </NavLink>
        </div>

        <hr class="text-white" />

        <div class="px-3">
            <label class="form-label text-white">File Path</label>
            <InputText class="form-control mb-2" @bind-Value="_filePath" />

            <button class="btn btn-primary w-100 mb-2" @onclick="SaveProject" type="button">
                Save Project
            </button>

            <button class="btn btn-secondary w-100" @onclick="LoadProject" type="button">
                Load Project
            </button>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="alert alert-info mt-2">@_message</div>
            }
        </div>
    </nav>
</div>

@code {
    private string _filePath = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.Desktop),
        "PWC_project",
        "PWC_Project.json");

    private string? _message;

    [Inject] private ProjectState ProjectState { get; set; } = default!;
    [Inject] private ProjectFileService FileService { get; set; } = default!;

    private async Task SaveProject()
    {
        try
        {
            await FileService.SaveAsync(ProjectState.Current, _filePath);
            _message = $"Project saved to {_filePath}";
        }
        catch (Exception ex)
        {
            _message = $"Save failed: {ex.Message}";
        }
    }

    private async Task LoadProject()
    {
        try
        {
            ProjectState.Load(await FileService.LoadAsync(_filePath));
            _message = $"Project loaded from {_filePath}";
        }
        catch (Exception ex)
        {
            _message = $"Load failed: {ex.Message}";
        }

        StateHasChanged();
    }
}