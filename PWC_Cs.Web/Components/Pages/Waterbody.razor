@page "/waterbody"
@rendermode InteractiveServer

<PageTitle>Waterbody</PageTitle>

@using PWC_Cs.Core.Models
@inject PWC_Cs.Web.Services.ProjectState ProjectState

<h1>Waterbody</h1>

<div class="form-check mb-2">
    <InputCheckbox class="form-check-input" @bind-Value="ProjectState.Current.Waterbody.UseEpaReservoir" />
    <label class="form-check-label">USEPA Reservoir</label>
</div>

<div class="form-check mb-2">
    <InputCheckbox class="form-check-input" @bind-Value="ProjectState.Current.Waterbody.UseEpaPond" />
    <label class="form-check-label">USEPA Pond</label>
</div>

<div class="form-check mb-2">
    <InputCheckbox class="form-check-input" @bind-Value="ProjectState.Current.Waterbody.UseEpaTpezWpez" />
    <label class="form-check-label">USEPA TPEZ &amp; WPEZ</label>
</div>

<div class="form-check mb-3">
    <InputCheckbox class="form-check-input" @bind-Value="ProjectState.Current.Waterbody.UseSprayBuffersForTpez" />
    <label class="form-check-label">Use Spray Buffers for TPEZ</label>
</div>

<hr />

<h3>Special Waterbodies</h3>

<div class="mb-3">
    <label class="form-label">New Special Waterbody</label>
    <InputText class="form-control" @bind-Value="_newSpecialWaterbody" />
</div>

<button type="button" class="btn btn-primary mb-3" @onclick="AddSpecialWaterbody">
    Add Special Waterbody
</button>

@if (ProjectState.Current.Waterbody.SpecialWaterbodies.Count == 0)
{
    <p>No special waterbodies added yet.</p>
}
else
{
    <ul>
        @foreach (var item in ProjectState.Current.Waterbody.SpecialWaterbodies)
        {
            <li>
                @item
                <button type="button" class="btn btn-sm btn-danger ms-2" @onclick="() => RemoveSpecialWaterbody(item)">
                    Remove
                </button>
            </li>
        }
    </ul>
}

@code {
    private string? _newSpecialWaterbody;

    private void AddSpecialWaterbody()
    {
        if (string.IsNullOrWhiteSpace(_newSpecialWaterbody))
            return;

        ProjectState.Current.Waterbody.SpecialWaterbodies.Add(_newSpecialWaterbody.Trim());
        _newSpecialWaterbody = string.Empty;
    }

    private void RemoveSpecialWaterbody(string item)
    {
        ProjectState.Current.Waterbody.SpecialWaterbodies.Remove(item);
    }
}