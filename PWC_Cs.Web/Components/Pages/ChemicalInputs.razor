@page "/chemical-inputs"
@rendermode InteractiveServer
@using PWC_Cs.Core.Models
@using System.ComponentModel.DataAnnotations

@inject PWC_Cs.Web.Services.ProjectState ProjectState

<h3>Chemical Inputs</h3>

<EditForm Model="ProjectState.Current.ChemicalInputs" FormName="ChemicalInputsForm" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label d-block">Chemical Level</label>

        <InputRadioGroup @bind-Value="ProjectState.Current.ChemicalInputs.ChemicalLevel" class="d-flex flex-row gap-3 align-items-center">
            <label class="form-check form-check-inline m-0">
                <InputRadio class="form-check-input" Value="@("Parent")" />
                <span class="form-check-label">Parent</span>
            </label>

            <label class="form-check form-check-inline m-0">
                <InputRadio class="form-check-input" Value="@("Daughter")" />
                <span class="form-check-label">Daughter</span>
            </label>

            <label class="form-check form-check-inline m-0">
                <InputRadio class="form-check-input" Value="@("Granddaughter")" />
                <span class="form-check-label">Granddaughter</span>
            </label>
        </InputRadioGroup>
    </div>

    @if (ProjectState.Current.ChemicalInputs.ChemicalLevel == "Parent" ||
         ProjectState.Current.ChemicalInputs.ChemicalLevel == "Daughter" ||
         ProjectState.Current.ChemicalInputs.ChemicalLevel == "Granddaughter")
    {
        <div class="mb-3">
            <label class="form-label">Sorption Parent</label>
            <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.SorptionParent" />
        </div>
    }

    @if (ProjectState.Current.ChemicalInputs.ChemicalLevel == "Daughter" ||
         ProjectState.Current.ChemicalInputs.ChemicalLevel == "Granddaughter")
    {
        <div class="mb-3">
            <label class="form-label">Sorption Daughter</label>
            <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.SorptionDaughter" />
        </div>
    }

    @if (ProjectState.Current.ChemicalInputs.ChemicalLevel == "Granddaughter")
    {
        <div class="mb-3">
            <label class="form-label">Sorption Granddaughter</label>
            <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.SorptionGranddaughter" />
        </div>
    }


    <div class="mb-3">
        <label class="form-label">Water Column Halflife</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.WaterColumnHalflife" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.WaterColumnHalflife)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Water Reference Temperature</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.WaterReferenceTemperature" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.WaterReferenceTemperature)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Benthic Halflife</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.BenthicHalflife" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.BenthicHalflife)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Benthic Reference Temperature</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.BenthicReferenceTemperature" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.BenthicReferenceTemperature)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Photo Halflife</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.PhotoHalflife" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.PhotoHalflife)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Photo Reference Temperature</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.PhotoReferenceTemperature" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.PhotoReferenceTemperature)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Hydrolysis Halflife</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.HydrolysisHalflife" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.HydrolysisHalflife)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Hydrolysis Reference Temperature</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.HydrolysisReferenceTemperature" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.HydrolysisReferenceTemperature)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Soil Halflife</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.SoilHalflife" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.SoilHalflife)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Soil Reference Temperature</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.SoilReferenceTemperature" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.SoilReferenceTemperature)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Foliar Halflife</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.FoliarHalflife" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.FoliarHalflife)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Foliar Washoff</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.FoliarWashoff" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.FoliarWashoff)" />
    </div>

    <div class="mb-3">
        <label class="form-label">MWT</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.MWT" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.MWT)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Vapor Pressure</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.VaporPressure" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.VaporPressure)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Solubility</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.Solubility" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.Solubility)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Henry</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.Henry" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.Henry)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Air Diffusion</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.AirDiffusion" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.AirDiffusion)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Heat Henry</label>
        <InputText class="form-control" @bind-Value="ProjectState.Current.ChemicalInputs.HeatHenry" />
        <ValidationMessage For="@(() => ProjectState.Current.ChemicalInputs.HeatHenry)" />
    </div>

    <button type="submit" class="btn btn-primary">Check Values</button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert alert-info mt-3">@_message</div>
}

@code {
    private string? _message;

    private void HandleValidSubmit()
    {
        _message = "Input is valid";
    }
}