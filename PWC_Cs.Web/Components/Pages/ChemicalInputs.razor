        <label class="form-label d-block">Chemical Level</label>

        <InputRadioGroup @bind-Value="ProjectState.Current.ChemicalInputs.ChemicalLevel" class="d-flex flex-row gap-3 align-items-center">
            <label class="form-check form-check-inline m-0">
                <InputRadio class="form-check-input" Value="@("Parent")" />
                <span class="form-check-label">Parent</span>
            </label>

            <label class="form-check form-check-inline m-0">
                <InputRadio class="form-check-input" Value="@("Daughter")" />
                <span class="form-check-label">Daughter</span>
            </label>

            <label class="form-check form-check-inline m-0">
                <InputRadio class="form-check-input" Value="@("Granddaughter")" />
                <span class="form-check-label">Granddaughter</span>
            </label>
        </InputRadioGroup>
    </div>

    <div class="mb-3">
        <label class="form-label">Sorption Type</label>
        <InputRadioGroup @bind-Value="ProjectState.Current.ChemicalInputs.SorptionType" class="d-flex flex-row gap-3 align-items-center">
            <label class="form-check form-check-inline m-0">
                <InputRadio class="form-check-input" Value="@("Koc")" />
                <span class="form-check-label">Koc</span>
            </label>

            <label class="form-check form-check-inline m-0">
                <InputRadio class="form-check-input" Value="@("Kd")" />
                <span class="form-check-label">Kd</span>
            </label>
        </InputRadioGroup>
    </div>

