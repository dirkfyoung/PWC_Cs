@page "/"
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Overview</PageTitle>

@using PWC_Cs.Web.Services
@using PWC_Cs.Core.Models

@inject ProjectState ProjectState

<h1>Overview</h1>

<div class="mb-3">
    <label class="form-label">Family Name</label>
    <InputText class="form-control" @bind-Value="ProjectState.Current.FamilyName" />
</div>

<div class="mb-3">
    <label class="form-label">Working Directory</label>
    <InputText class="form-control" @bind-Value="ProjectState.Current.WorkingDirectory" />
</div>

<div class="mb-3">
    <label class="form-label">Weather File Directory</label>
    <InputText class="form-control" @bind-Value="ProjectState.Current.WeatherFileDirectory" />
</div>

<hr />

<h3>Project Summary</h3>
<p>Use the navigation menu to move between sections.</p>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert alert-info mt-3">@_message</div>
}

@code {
    private string? _message;

    protected override void OnInitialized()
    {
        ProjectState.OnChange += OnProjectStateChanged;
    }

    private async void OnProjectStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ProjectState.OnChange -= OnProjectStateChanged;
    }
}